<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EngineLab.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:EngineLab.Views"
    Shell.FlyoutBehavior="Disabled">

    <!-- First ShellContent = startup page -->
    <Tab Title="Presets" Route="PresetsPage">
        <ShellContent ContentTemplate="{DataTemplate views:PresetsPage}" />
    </Tab>

    <Tab Title="Dyno" Route="MainPage">
        <ShellContent ContentTemplate="{DataTemplate views:MainPage}" />
    </Tab>
</Shell>