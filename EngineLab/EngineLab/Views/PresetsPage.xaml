<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EngineLab.Views.PresetsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:EngineLab.Helpers"
    xmlns:models="clr-namespace:EngineLabLib.Models;assembly=EngineLabLib"
    xmlns:views="clr-namespace:EngineLab.Views"
    x:DataType="views:PresetsPage"
    Title="Presets">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Instantiate the converter once -->
            <conv:BoolToPresetTypeConverter x:Key="PresetTypeConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="16" Spacing="12">

        <Label Text="Engine Presets"
               FontSize="24"
               FontAttributes="Bold" />

        <!-- Status / error text -->
        <Label x:Name="StatusLabel"
               FontSize="12"
               TextColor="OrangeRed"
               LineBreakMode="WordWrap" />

        <!-- List of presets -->
        <CollectionView x:Name="PresetList"
                        ItemsSource="{Binding Presets}"
                        SelectionMode="Single"
                        SelectionChanged="OnPresetSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:EnginePreset">
                    <Frame Margin="0,6"
                           Padding="12"
                           CornerRadius="12"
                           HasShadow="True">

                        <!-- Use a grid so we can put text on the left, Delete button on the right -->
                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto">

                            <!-- Left side: name, description, type -->
                            <VerticalStackLayout Grid.Column="0" Spacing="4">

                                <!-- Preset name -->
                                <Label Text="{Binding Name}"
                                       FontSize="18"
                                       FontAttributes="Bold" />

                                <!-- Optional description -->
                                <Label Text="{Binding Description}"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation" />

                                <!-- Source info -->
                                <Label FontSize="12"
                                       TextColor="Gray">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Type: " />
                                            <Span Text="{Binding IsBuiltIn, Converter={StaticResource PresetTypeConverter}}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                            </VerticalStackLayout>

                            <!-- Right side: Delete button (only for user presets) -->
                            <Button Grid.Column="1"
                                    Text="Delete"
                                    Margin="8,0,0,0"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding IsUserPreset}"
                                    Clicked="OnDeletePresetClicked" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>