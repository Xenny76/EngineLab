<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EngineLab.Views.PresetsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:EngineLab.Helpers"
    xmlns:models="clr-namespace:EngineLabLib.Models;assembly=EngineLabLib"
    xmlns:views="clr-namespace:EngineLab.Views"
    x:DataType="views:PresetsPage"
    Title="Presets">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Instantiate the converter once -->
            <conv:BoolToPresetTypeConverter x:Key="PresetTypeConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="16" Spacing="12">

        <Label Text="Engine Presets"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light={StaticResource MidnightBlue},
                                         Dark={StaticResource White}}" />

        <Label x:Name="StatusLabel"
               FontSize="12"
               TextColor="OrangeRed"
               LineBreakMode="WordWrap" />

        <CollectionView x:Name="PresetList"
                        ItemsSource="{Binding Presets}"
                        SelectionMode="Single"
                        SelectionChanged="OnPresetSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:EnginePreset">
                    <Border Margin="0,6"
                            Style="{StaticResource CardBorder}">

                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto">

                            <VerticalStackLayout Grid.Column="0" Spacing="4">

                                <Label Text="{Binding Name}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                     Dark={StaticResource Gray100}}" />

                                <Label Text="{Binding Description}"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600},
                                                     Dark={StaticResource Gray400}}" />

                                <Label FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                     Dark={StaticResource Gray400}}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Type: " />
                                            <Span Text="{Binding IsBuiltIn, Converter={StaticResource PresetTypeConverter}}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="Delete"
                                    Margin="8,0,0,0"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding IsUserPreset}"
                                    BackgroundColor="#B91C1C"
                                    TextColor="White"
                                    CornerRadius="8"
                                    Padding="10,6" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>