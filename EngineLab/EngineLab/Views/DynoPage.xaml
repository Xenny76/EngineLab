<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EngineLab.Views.DynoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dyno">

    <!-- Toolbar: presets + save preset -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Presets"
                     Order="Primary"
                     Priority="0"
                     Clicked="OnChangePresetClicked" />
        <ToolbarItem Text="Save preset"
                     Order="Primary"
                     Priority="1"
                     Clicked="OnSavePresetClicked" />
    </ContentPage.ToolbarItems>

    <Grid x:Name="RootGrid"
          Padding="12"
          RowSpacing="8"
          ColumnSpacing="12"
          RowDefinitions="Auto,*"
          ColumnDefinitions="7*,3*">

        <!-- Status -->
        <Label x:Name="Status"
               Grid.Row="0"
               Grid.ColumnSpan="2"
               Text="Initializing…"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                         Dark={StaticResource Gray100}}" />

        <!-- Plot area -->
        <Border x:Name="PlotHost"
                Grid.Row="1"
                Grid.Column="0"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light=#F9FAFB,
                                                  Dark=#020617}"
                Stroke="{AppThemeBinding Light={StaticResource Gray300},
                                          Dark={StaticResource Gray600}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8">
            <Image x:Name="DynoImage"
                   Aspect="AspectFit" />
        </Border>

        <!-- Right: controls (scrollable) + pinned metrics -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Padding="12"
                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary},
                                                  Dark={StaticResource Secondary}}"
                Stroke="{AppThemeBinding Light={StaticResource Gray300},
                                          Dark={StaticResource Gray600}}"
                StrokeShape="RoundRectangle 12">
            <Grid RowDefinitions="*,Auto">

                <!-- Scrollable controls -->
                <ScrollView Grid.Row="0">
                    <VerticalStackLayout Spacing="12"
                                         Padding="0,0,10,0">

                        <Label Text="Quick Mods"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light={StaticResource SecondaryDarkText},
                                         Dark={StaticResource SecondaryDarkText}}" />

                        <!-- ========== CORE GEOMETRY ========== -->
                        <Label Text="Core Geometry"
               Style="{StaticResource SectionHeaderLabel}" />

                        <!-- Bore -->
                        <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto">
                            <Label Grid.Column="0" Text="Bore" VerticalOptions="Center" />
                            <Slider x:Name="SliderBore" Grid.Column="1"
                    AutomationId="Bore_mm"
                    Minimum="0" Maximum="200"
                    ValueChanged="OnSliderChanged" />
                            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="4"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">
                                <Entry x:Name="EntryBore"
                       AutomationId="Bore_mm"
                       WidthRequest="72"
                       HorizontalTextAlignment="End"
                       Keyboard="Numeric"
                       Completed="OnEntryCompleted"
                       Unfocused="OnEntryUnfocused" />
                                <Label Text="mm" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Stroke -->
                        <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto">
                            <Label Grid.Column="0" Text="Stroke" VerticalOptions="Center" />
                            <Slider x:Name="SliderStroke" Grid.Column="1"
                    AutomationId="Stroke_mm"
                    Minimum="0" Maximum="200"
                    ValueChanged="OnSliderChanged" />
                            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="4"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">
                                <Entry x:Name="EntryStroke"
                       AutomationId="Stroke_mm"
                       WidthRequest="72"
                       HorizontalTextAlignment="End"
                       Keyboard="Numeric"
                       Completed="OnEntryCompleted"
                       Unfocused="OnEntryUnfocused" />
                                <Label Text="mm" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- ========== FUEL / LIMITS ========== -->
                        <Label Text="Fuel &amp; Limits"
               Style="{StaticResource SectionHeaderLabel}" />

                        <!-- WOT Lambda (no unit) -->
                        <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto">
                            <Label Grid.Column="0" Text="WOT Lambda" VerticalOptions="Center" />
                            <Slider x:Name="SliderLambda" Grid.Column="1"
                    AutomationId="WOT_Lambda"
                    Minimum="0.6" Maximum="1.2"
                    ValueChanged="OnSliderChanged" />
                            <Entry x:Name="EntryLambda"
                   Grid.Column="2"
                   AutomationId="WOT_Lambda"
                   WidthRequest="72"
                   HorizontalTextAlignment="End"
                   Keyboard="Numeric"
                   HorizontalOptions="End"
                   Completed="OnEntryCompleted"
                   Unfocused="OnEntryUnfocused" />
                        </Grid>

                        <!-- Redline RPM -->
                        <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto">
                            <Label Grid.Column="0" Text="Redline" VerticalOptions="Center" />
                            <Slider x:Name="SliderRedline" Grid.Column="1"
                    AutomationId="Redline_RPM"
                    Minimum="2000" Maximum="10000"
                    ValueChanged="OnSliderChanged" />
                            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="4"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">
                                <Entry x:Name="EntryRedline"
                       AutomationId="Redline_RPM"
                       WidthRequest="90"
                       HorizontalTextAlignment="End"
                       Keyboard="Numeric"
                       Completed="OnEntryCompleted"
                       Unfocused="OnEntryUnfocused" />
                                <Label Text="RPM" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- ========== INTAKE ========== -->
                        <Label Text="Intake"
               Style="{StaticResource SectionHeaderLabel}" />

                        <!-- Runner Length -->
                        <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto">
                            <Label Grid.Column="0" Text="Runner Length" VerticalOptions="Center" />
                            <Slider x:Name="SliderRunnerLen" Grid.Column="1"
                    AutomationId="RunnerLength_mm"
                    Minimum="0" Maximum="1000"
                    ValueChanged="OnSliderChanged" />
                            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="4"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">
                                <Entry x:Name="EntryRunnerLen"
                       AutomationId="RunnerLength_mm"
                       WidthRequest="72"
                       HorizontalTextAlignment="End"
                       Keyboard="Numeric"
                       Completed="OnEntryCompleted"
                       Unfocused="OnEntryUnfocused" />
                                <Label Text="mm" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Throttle Diameter -->
                        <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto">
                            <Label Grid.Column="0" Text="Throttle Ø" VerticalOptions="Center" />
                            <Slider x:Name="SliderThrottle" Grid.Column="1"
                    AutomationId="ThrottleDiameter_mm"
                    Minimum="0" Maximum="120"
                    ValueChanged="OnSliderChanged" />
                            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="4"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">
                                <Entry x:Name="EntryThrottle"
                       AutomationId="ThrottleDiameter_mm"
                       WidthRequest="72"
                       HorizontalTextAlignment="End"
                       Keyboard="Numeric"
                       Completed="OnEntryCompleted"
                       Unfocused="OnEntryUnfocused" />
                                <Label Text="mm" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- ========== CAM / VALVETRAIN ========== -->
                        <Label Text="Cam / Valvetrain"
               Style="{StaticResource SectionHeaderLabel}" />

                        <!-- Intake Duration -->
                        <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto">
                            <Label Grid.Column="0" Text="Intake Dur @ .050" VerticalOptions="Center" />
                            <Slider x:Name="SliderIntakeDur" Grid.Column="1"
                    AutomationId="Cam.IntakeDuration_deg050"
                    Minimum="160" Maximum="360"
                    ValueChanged="OnSliderChanged" />
                            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="4"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">
                                <Entry x:Name="EntryIntakeDur"
                       AutomationId="Cam.IntakeDuration_deg050"
                       WidthRequest="72"
                       HorizontalTextAlignment="End"
                       Keyboard="Numeric"
                       Completed="OnEntryCompleted"
                       Unfocused="OnEntryUnfocused" />
                                <Label Text="°" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Exhaust Duration -->
                        <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto">
                            <Label Grid.Column="0" Text="Exhaust Dur @ .050" VerticalOptions="Center" />
                            <Slider x:Name="SliderExhaustDur" Grid.Column="1"
                    AutomationId="Cam.ExhaustDuration_deg050"
                    Minimum="160" Maximum="360"
                    ValueChanged="OnSliderChanged" />
                            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="4"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">
                                <Entry x:Name="EntryExhaustDur"
                       AutomationId="Cam.ExhaustDuration_deg050"
                       WidthRequest="72"
                       HorizontalTextAlignment="End"
                       Keyboard="Numeric"
                       Completed="OnEntryCompleted"
                       Unfocused="OnEntryUnfocused" />
                                <Label Text="°" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Intake Max Lift -->
                        <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto">
                            <Label Grid.Column="0" Text="Intake Max Lift" VerticalOptions="Center" />
                            <Slider x:Name="SliderIntLift" Grid.Column="1"
                    AutomationId="Cam.IntakeMaxLift_mm"
                    Minimum="0" Maximum="30"
                    ValueChanged="OnSliderChanged" />
                            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="4"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">
                                <Entry x:Name="EntryIntLift"
                       AutomationId="Cam.IntakeMaxLift_mm"
                       WidthRequest="72"
                       HorizontalTextAlignment="End"
                       Keyboard="Numeric"
                       Completed="OnEntryCompleted"
                       Unfocused="OnEntryUnfocused" />
                                <Label Text="mm" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Exhaust Max Lift -->
                        <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto">
                            <Label Grid.Column="0" Text="Exhaust Max Lift" VerticalOptions="Center" />
                            <Slider x:Name="SliderExhLift" Grid.Column="1"
                    AutomationId="Cam.ExhaustMaxLift_mm"
                    Minimum="0" Maximum="30"
                    ValueChanged="OnSliderChanged" />
                            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="4"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">
                                <Entry x:Name="EntryExhLift"
                       AutomationId="Cam.ExhaustMaxLift_mm"
                       WidthRequest="72"
                       HorizontalTextAlignment="End"
                       Keyboard="Numeric"
                       Completed="OnEntryCompleted"
                       Unfocused="OnEntryUnfocused" />
                                <Label Text="mm" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Lobe Separation Angle -->
                        <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto">
                            <Label Grid.Column="0" Text="Lobe Sep Angle" VerticalOptions="Center" />
                            <Slider x:Name="SliderLSA" Grid.Column="1"
                    AutomationId="Cam.LobeSeparationAngle_deg"
                    Minimum="90" Maximum="130"
                    ValueChanged="OnSliderChanged" />
                            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="4"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">
                                <Entry x:Name="EntryLSA"
                       AutomationId="Cam.LobeSeparationAngle_deg"
                       WidthRequest="72"
                       HorizontalTextAlignment="End"
                       Keyboard="Numeric"
                       Completed="OnEntryCompleted"
                       Unfocused="OnEntryUnfocused" />
                                <Label Text="°" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- ========== EXHAUST ========== -->
                        <Label Text="Exhaust"
               Style="{StaticResource SectionHeaderLabel}" />

                        <!-- Primary Length 1 -->
                        <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto">
                            <Label Grid.Column="0" Text="Primary Length 1" VerticalOptions="Center" />
                            <Slider x:Name="SliderPrimLen1" Grid.Column="1"
                    AutomationId="PrimaryLength1_mm"
                    Minimum="0" Maximum="1000"
                    ValueChanged="OnSliderChanged" />
                            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="4"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">
                                <Entry x:Name="EntryPrimLen1"
                       AutomationId="PrimaryLength1_mm"
                       WidthRequest="72"
                       HorizontalTextAlignment="End"
                       Keyboard="Numeric"
                       Completed="OnEntryCompleted"
                       Unfocused="OnEntryUnfocused" />
                                <Label Text="mm" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Primary Length 2 -->
                        <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto">
                            <Label x:Name="LblPrimLen2" Grid.Column="0"
                   Text="Primary Length 2" VerticalOptions="Center" />
                            <Slider x:Name="SliderPrimLen2" Grid.Column="1"
                    AutomationId="PrimaryLength2_mm"
                    Minimum="0" Maximum="1000"
                    ValueChanged="OnSliderChanged" />
                            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="4"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">
                                <Entry x:Name="EntryPrimLen2"
                       AutomationId="PrimaryLength2_mm"
                       WidthRequest="72"
                       HorizontalTextAlignment="End"
                       Keyboard="Numeric"
                       Completed="OnEntryCompleted"
                       Unfocused="OnEntryUnfocused" />
                                <Label Text="mm" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Primary ID -->
                        <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto">
                            <Label Grid.Column="0" Text="Primary ID" VerticalOptions="Center" />
                            <Slider x:Name="SliderPrimID" Grid.Column="1"
                    AutomationId="PrimaryID_mm"
                    Minimum="0" Maximum="100"
                    ValueChanged="OnSliderChanged" />
                            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="4"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">
                                <Entry x:Name="EntryPrimID"
                       AutomationId="PrimaryID_mm"
                       WidthRequest="72"
                       HorizontalTextAlignment="End"
                       Keyboard="Numeric"
                       Completed="OnEntryCompleted"
                       Unfocused="OnEntryUnfocused" />
                                <Label Text="mm" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Guard-rail notifications -->
                        <Label x:Name="GuardRail"
               FontSize="12"
               TextColor="OrangeRed"
               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Pinned metrics panel -->
                <Border Grid.Row="1"
                        Padding="10"
                        BackgroundColor="{AppThemeBinding Light=#E5E7EB,
                                                          Dark=#020617}"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300},
                                                  Dark={StaticResource Gray600}}"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Comparison Metrics"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                     Dark={StaticResource Gray100}}" />
                        <Label x:Name="Metrics"
                               FontAttributes="Italic"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                     Dark={StaticResource Gray300}}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>